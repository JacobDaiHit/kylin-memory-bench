{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kylin-memory-bench:case:1.0",
  "title": "KMB JSONL case (one object per line)",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "dimension",
    "synthetic",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "dimension": {
      "enum": [
        "retention",
        "retrieval",
        "update",
        "disambiguation",
        "boundary",
        "reuse"
      ]
    },
    "synthetic": {
      "const": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "session",
          "day",
          "prompt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "kind": {
            "enum": [
              "message",
              "probe",
              "task"
            ]
          },
          "session": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "day": {
            "type": "integer",
            "minimum": 0
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "source",
                "op",
                "failure"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
                },
                "source": {
                  "enum": [
                    "response",
                    "memory",
                    "actions",
                    "artifact"
                  ]
                },
                "op": {
                  "enum": [
                    "equals",
                    "contains",
                    "excludes",
                    "exists",
                    "absent",
                    "json_subset",
                    "one_of",
                    "json_keys",
                    "json_exact"
                  ]
                },
                "failure": {
                  "enum": [
                    "omission",
                    "confusion",
                    "stale_memory",
                    "wrong_persistence",
                    "wrong_reuse",
                    "invalid_format"
                  ]
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "path": {
                  "type": "string"
                },
                "pointer": {
                  "type": "string",
                  "pattern": "^(/.*)?$"
                },
                "value": {},
                "measurement_domain": {
                  "enum": [
                    "content",
                    "format",
                    "authorization",
                    "storage",
                    "artifact",
                    "actions"
                  ]
                },
                "mismatch_values": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "value",
                      "category"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "value": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      },
                      "category": {
                        "enum": [
                          "omission",
                          "confusion",
                          "stale_memory",
                          "wrong_persistence",
                          "wrong_reuse",
                          "invalid_format"
                        ]
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "source": {
                        "const": "artifact"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "op": {
                        "enum": [
                          "equals",
                          "contains",
                          "excludes",
                          "json_subset",
                          "one_of",
                          "json_keys",
                          "json_exact"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "value"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "op": {
                        "const": "one_of"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 32,
                        "items": {
                          "type": [
                            "string",
                            "number",
                            "boolean",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "op": {
                        "const": "json_keys"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 256,
            "maximum": 8192
          }
        }
      }
    },
    "grading_contract": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "state_policy": {
      "enum": [
        "persistent",
        "fresh_each_session"
      ]
    }
  }
}
